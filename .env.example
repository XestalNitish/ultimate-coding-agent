# ============================================================
# Ultimate Coding Agent — Environment Configuration Template
# Copy this file to .env and adjust variables as needed.
# ============================================================

# ---------------- LangSmith Observability ----------------
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_PROJECT="ultimate-coding-agent"
LANGCHAIN_API_KEY=""

# ---------------- Local LLM Server 1 (Main/Planner/RAG) ----------------
XESTAL_PORT=8082
CODE_DEV_LLM_URL="http://127.0.0.1:8082"
XESTAL_GPU_LAYERS=0
XESTAL_CTX=16384
LLM_THREADS=6

# ---------------- Local LLM Server 2 (Coder Writer Node) ----------------
XESTAL_PORT2=8084
CODE_DEV_WRITER_PORT=8084
CODE_DEV_WRITER_URL="http://127.0.0.1:8084"
CODE_DEV_WRITER_CTX_TOKENS=16384

# ---------------- Hardware & Binary Overrides (Optional) ----------------
# LLAMA_SERVER_BIN="d:/local llm/llama_bin/llama-server.exe"
# XESTAL_MODEL_PATH="models/XHToken__Spark-X2.5-4B-GGUF/Spark-X2.5-4B-Q4_K_M.gguf"
# XESTAL_KEEP_SERVER=1

# ---------------- Cloud LLM API Keys (Optional Fallbacks) ----------------
# GROQ_API_KEY=""
# GEMINI_API_KEY=""
# OPENAI_API_KEY=""

# ---------------- Pipeline Control ----------------
# PIPELINE_RESEARCH=auto        # auto | on | off
# PIPELINE_RESEARCH_DEPTH=advanced
# PIPELINE_MAX_RESTARTS=2
# PIPELINE_CODER_REPLANS=1
